import java.util.ArrayList;
import java.util.Scanner;

/**
 * AverageCalculator - Score Tracker Edition
 * Lets the user enter named scores (e.g. subjects) until they type "done".
 * Then it shows the average, highest, lowest, a mini bar chart, and a remark.
 */
public class AverageCalculator {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        ArrayList<String> names = new ArrayList<>();
        ArrayList<Double> scores = new ArrayList<>();

        System.out.println("==============================");
        System.out.println("   SCORE TRACKER & AVERAGER   ");
        System.out.println("==============================");
        System.out.println("Enter a name and a score for each item.");
        System.out.println("Type 'done' as the name when you are finished.\n");

        // Keep collecting entries until the user types "done"
        while (true) {
            System.out.print("Name (or 'done'): ");
            String name = scanner.nextLine().trim();

            if (name.equalsIgnoreCase("done")) {
                if (scores.isEmpty()) {
                    System.out.println("Please enter at least one score first.\n");
                    continue;
                }
                break;
            }
            if (name.isEmpty()) {
                System.out.println("Name cannot be empty.\n");
                continue;
            }

            System.out.print("Score for " + name + " (0-100): ");
            try {
                double score = Double.parseDouble(scanner.nextLine().trim());
                if (score < 0 || score > 100) {
                    System.out.println("Score must be between 0 and 100.\n");
                    continue;
                }
                names.add(name);
                scores.add(score);
                System.out.println("Saved! (" + scores.size() + " so far)\n");
            } catch (NumberFormatException e) {
                System.out.println("That is not a valid number. Try again.\n");
            }
        }

        // Work out sum, highest and lowest
        double sum = 0;
        int highIndex = 0;
        int lowIndex = 0;
        for (int i = 0; i < scores.size(); i++) {
            sum += scores.get(i);
            if (scores.get(i) > scores.get(highIndex)) highIndex = i;
            if (scores.get(i) < scores.get(lowIndex)) lowIndex = i;
        }
        double average = sum / scores.size();

        // Display the report
        System.out.println("\n========== REPORT ==========");
        for (int i = 0; i < scores.size(); i++) {
            int stars = (int) Math.round(scores.get(i) / 5); // 1 star = 5 marks
            System.out.printf("%-15s %6.1f | %s%n", names.get(i), scores.get(i), "*".repeat(stars));
        }
        System.out.println("----------------------------");
        System.out.printf("Total entries : %d%n", scores.size());
        System.out.printf("Sum           : %.1f%n", sum);
        System.out.printf("Average       : %.2f%n", average);
        System.out.printf("Highest       : %s (%.1f)%n", names.get(highIndex), scores.get(highIndex));
        System.out.printf("Lowest        : %s (%.1f)%n", names.get(lowIndex), scores.get(lowIndex));
        System.out.println("Remark        : " + getRemark(average));
        System.out.println("============================");

        scanner.close();
    }

    // Returns a short remark based on the average
    private static String getRemark(double average) {
        if (average >= 70) return "Excellent work!";
        if (average >= 60) return "Very good, keep it up.";
        if (average >= 50) return "Good, but you can aim higher.";
        if (average >= 40) return "Fair. More practice needed.";
        return "Needs improvement. Don't give up!";
    }
}
